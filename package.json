{
  "name": "ai-social-media-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ai-social/web",
    "dev:web": "npm run dev --workspace=@ai-social/web",
    "dev:api": "npm run dev --workspace=@ai-social/api",
    "build": "npm run build --workspaces --if-present && node -e \"const fs=require('fs'); fs.rmSync('./.next', {recursive:true, force:true}); fs.cpSync('./apps/web/.next', './.next', {recursive:true});\"",
    "build:web": "npm run build --workspace=@ai-social/web",
    "build:api": "npm run build --workspace=@ai-social/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "worker:generation": "npm run worker:generation --workspace=@ai-social/api",
    "worker:publishing": "npm run worker:publishing --workspace=@ai-social/api",
    "worker:analytics": "npm run worker:analytics --workspace=@ai-social/api",
    "db:generate": "npm run db:generate --workspace=@ai-social/database",
    "db:push": "npm run db:push --workspace=@ai-social/database",
    "seed:test-user": "tsx scripts/seed-test-user.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "playwright": "^1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/config": "^7.9.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
